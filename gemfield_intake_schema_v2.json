 "core": [
  {
   "id": "D-101",
   "label": "Business name",
   "hint": "",
   "type": "text",
   "prefill": "business_name",
   "required": true
  },
  {
   "id": "D-201",
   "label": "What do you do, in one line",
   "hint": "E.g., \"Residential AC repair and installation\"",
   "type": "text",
   "required": true
  },
  {
   "id": "D-205",
   "label": "Where do you serve?",
   "hint": "Cities or area — e.g., \"Iloilo City + 30km\"",
   "type": "text",
   "required": true
  },
  {
   "id": "D-501",
   "label": "When someone lands on your site, the #1 thing they should do:",
   "options": [
    "Call me",
    "Book an appointment",
    "Request a quote",
    "Message me (WhatsApp/text)",
    "Visit my location"
   ],
   "hint": "",
   "type": "choice",
   "required": true
  },
  {
   "id": "D-801",
   "label": "Send new leads to:",
   "hint": "The email (or phone for texts) that gets notified",
   "type": "text",
   "required": true
  },
  {
   "id": "D-703",
   "label": "Your brand in up to 3 words:",
   "options": [
    "Trustworthy",
    "Modern",
    "Friendly",
    "Premium",
    "Bold",
    "Local",
    "Expert",
    "No-nonsense"
   ],
   "hint": "",
   "type": "multichoice",
   "max": 3,
   "required": true
  },
  {
   "id": "D-720",
   "label": "Pick the style closest to your taste:",
   "options": [
    "Clean & modern",
    "Warm & friendly",
    "Bold & confident",
    "Premium & elegant"
   ],
   "hint": "We design from this — you'll refine on the preview",
   "type": "choice",
   "required": true,
   "derives": [
    "D-705",
    "D-706",
    "D-708"
   ]
  },
  {
   "id": "D-721",
   "label": "Colors:",
   "options": [
    "Use my logo's colors",
    "I'll name them below",
    "You choose for me"
   ],
   "hint": "",
   "type": "choice",
   "required": true
  },
  {
   "id": "D-704",
   "label": "If naming colors: which?",
   "hint": "E.g., \"navy and orange\" — skip if not applicable",
   "type": "text",
   "optional": true
  },
  {
   "id": "D-722",
   "label": "What do you have ready?",
   "options": [
    "Logo + photos of our work",
    "Logo only",
    "Photos only",
    "Neither yet"
   ],
   "hint": "We'll send an upload link after — nothing needed now",
   "type": "choice",
   "required": true,
   "derives": [
    "D-710",
    "D-707"
   ]
  },
  {
   "id": "D-723",
   "label": "A website you like (optional)",
   "hint": "Any industry — paste a link",
   "type": "text",
   "optional": true
  },
  {
   "id": "D-906",
   "label": "Anything we must know? (optional)",
   "hint": "",
   "type": "text",
   "optional": true
  }
 ],
